# ==================== CELL 1: DEFINE FUNCTION & DERIVATIVE ====================
import matplotlib.pyplot as plt
import numpy as np

# Objective function to minimize: f(x) = (x + 3)^2
def f(x):
    return (x + 3) ** 2

# First derivative (gradient): f'(x) = 2 * (x + 3)
def derivative(x):
    return 2 * (x + 3)

print("Objective function f(x) and its derivative f'(x) successfully defined!")

# ==================== CELL 2: GRADIENT DESCENT FUNCTION ====================
def gradient_descent(x_start, learning_rate, iterations, verbose_every=10):
    x = x_start
    path = [(x, f(x))]
    
    for i in range(iterations):
        grad = derivative(x)
        x = x - learning_rate * grad  # Core update rule: x_new = x - lr * f'(x)
        path.append((x, f(x)))
        
        if verbose_every > 0 and i % verbose_every == 0:
            print(f"Iteration {i:3d}: x = {x:10.6f}, f(x) = {f(x):10.6f}, Gradient = {grad:10.6f}")
            
    return x, path

# ==================== CELL 3: RUN GRADIENT DESCENT (x_start = 2, lr = 0.1) ====================
x_start = 2
learning_rate = 0.1
iterations = 100

print(f"=== RUNNING GRADIENT DESCENT (Start x = {x_start}, lr = {learning_rate}) ===")
x_min, descent_path = gradient_descent(x_start, learning_rate, iterations, verbose_every=10)

print("\n=== FINAL RESULTS ===")
print(f"Calculated Minimum Point  : x = {x_min:.6f}")
print(f"Calculated Minimum Value  : y = {f(x_min):.10f}")
print("Theoretical Exact Minimum : x = -3.000000, y = 0.000000")

# ==================== CELL 4: COMPARE LEARNING RATES ====================
learning_rates = [0.01, 0.1, 0.5, 0.9, 1.0]

print("\n=== EFFECT OF LEARNING RATE ON CONVERGENCE (100 Iterations) ===")
for lr in learning_rates:
    final_x, _ = gradient_descent(x_start, lr, iterations, verbose_every=0)
    status = "Converged" if abs(final_x - (-3)) < 1e-3 else ("Oscillating/Diverged" if lr >= 1.0 else "Slow Convergence")
    print(f"Learning Rate = {lr:<5} | Final x = {final_x:10.6f} | f(x) = {f(final_x):12.6g} | Status: {status}")

# ==================== CELL 5: VISUALIZATIONS (PARABOLA TRAJECTORY & LOG LOSS) ====================
# 1. Plot Parabola Trajectory
xs = [p[0] for p in descent_path]
ys = [p[1] for p in descent_path]

curve_x = np.linspace(-6, 3, 500)
curve_y = f(curve_x)

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

axes[0].plot(curve_x, curve_y, color="gray", linewidth=2, label=r"$f(x) = (x + 3)^2$")
axes[0].plot(xs, ys, "o-", color="red", markersize=4, linewidth=1, label="Gradient Descent Steps")
axes[0].plot(x_start, f(x_start), "go", markersize=8, label=f"Start (x = {x_start})")
axes[0].plot(x_min, f(x_min), "b*", markersize=14, label=f"Min Found (x ≈ {x_min:.2f})")
axes[0].set_title(f"Gradient Descent Trajectory (lr = {learning_rate})")
axes[0].set_xlabel("x")
axes[0].set_ylabel("f(x)")
axes[0].grid(alpha=0.3)
axes[0].legend()

# 2. Plot Convergence Speed across Learning Rates
for lr in learning_rates:
    _, path = gradient_descent(x_start, lr, iterations, verbose_every=0)
    loss_values = [p[1] for p in path]
    axes[1].plot(loss_values, label=f"lr = {lr}")

axes[1].set_title("Convergence Loss vs Iterations (Log Scale)")
axes[1].set_xlabel("Iteration")
axes[1].set_ylabel("f(x) Value (Log Scale)")
axes[1].set_yscale("log")
axes[1].grid(alpha=0.3)
axes[1].legend()

plt.tight_layout()
plt.show()

2. MATHEMATICAL DERIVATION & ALGORITHM LOGIC
--------------------------------------------------------------------------------
A. Mathematical Foundation:
   - Objective Function: $f(x) = (x + 3)^2$
   - Gradient / Derivative: $\frac{df}{dx} = 2(x + 3)$
   - Critical Point: Setting $f'(x) = 0 \implies 2(x + 3) = 0 \implies x = -3$.
   - Second Derivative Test: $f''(x) = 2 > 0$ (Confirms $x = -3$ is a Local Minimum).

B. Gradient Descent Update Rule:
   $$x_{new} = x_{old} - \alpha \cdot f'(x_{old})$$
   where $\alpha$ is the Learning Rate.

C. Step-by-Step Numerical Walkthrough ($\alpha = 0.1, x_0 = 2$):
   - Iteration 0: $x_0 = 2 \implies f'(2) = 2(2 + 3) = 10$
     $x_1 = 2 - 0.1(10) = 1.0$
   - Iteration 1: $x_1 = 1.0 \implies f'(1) = 2(1 + 3) = 8$
     $x_2 = 1.0 - 0.1(8) = 0.2$
   - Iteration 2: $x_2 = 0.2 \implies f'(0.2) = 2(0.2 + 3) = 6.4$
     $x_3 = 0.2 - 0.1(6.4) = -0.44$
   - As $x$ approaches $-3$, the gradient $f'(x)$ approaches $0$, causing step size to automatically shrink.

